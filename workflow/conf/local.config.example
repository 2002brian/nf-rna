// Intentionally path-free. Execution freezes this local research policy per run.
// It keeps one local research run within an 8 CPU / 12 GiB Docker ceiling.
executor { cpus = 8; memory = '12.GB' }
process {
  resourceLimits = [cpus: 8, memory: '12.GB', time: '12.h']
  withLabel:process_low { cpus = 1; memory = '2.GB'; time = '2.h' }
  withLabel:process_medium { cpus = 4; memory = '8.GB'; time = '8.h' }
  withLabel:process_high { cpus = 8; memory = '12.GB'; time = '12.h' }
  withName: '.*:SALMON_QUANT' { cpus = 4; memory = '8.GB'; time = '8.h'; maxForks = 1 }
}
