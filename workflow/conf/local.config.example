// Intentionally path-free. Execution freezes this local research policy per run.
// It keeps one local research run within an 8 CPU / 12 GiB aggregate ceiling.
// Process-specific requests (including nf-core labels) remain unchanged.
executor { cpus = 8; memory = '12.GB' }
process {
  resourceLimits = [cpus: 8, memory: '12.GB', time: '12.h']
}
