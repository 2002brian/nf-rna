profiles {
  docker {
    docker.enabled = true
    // This is the one first-party downstream runtime image. It is also the
    // exact image inspected by `rnaseq doctor` before a service run starts.
    process.container = 'rnaseq-control-plane:latest'
  }
  local {
    process.executor = 'local'
  }
  server {
    // Executor-specific settings are intentionally deferred until a server is selected.
  }
}

executor {
  cpus = 8
  memory = '12 GB'
}

process {
  errorStrategy = 'terminate'
  // M5: explicit local contracts. These declarations do not alter analysis.
  resourceLimits = [cpus: 8, memory: '12 GB', time: '12 h']
  withName: L1_ANALYSIS { cpus = 1; memory = '2 GB'; time = '2 h'; maxForks = 1 }
  withName: L2_ANALYSIS { cpus = 4; memory = '8 GB'; time = '8 h'; maxForks = 1 }
  withName: ENRICHMENT_ANALYSIS { cpus = 4; memory = '8 GB'; time = '8 h'; maxForks = 1 }
  withName: TECHNICAL_REPORT { cpus = 1; memory = '2 GB'; time = '2 h'; maxForks = 1 }
  withName: TECHNICAL_REPORT_NO_ENRICHMENT { cpus = 1; memory = '2 GB'; time = '2 h'; maxForks = 1 }
  withName: TECHNICAL_REPORT_L1 { cpus = 1; memory = '2 GB'; time = '2 h'; maxForks = 1 }
}
